{
  "name": "@warimaru/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:mock": "NEXT_PUBLIC_MOCK=1 next dev --port 3000",
    "build": "next build",
    "build:mock": "NEXT_PUBLIC_MOCK=1 next build",
    "bundle-size": "node scripts/check-bundle-size.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "next lint && stylelint --allow-empty-input 'src/**/*.css'",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@line/liff": "^2.29.1",
    "@tanstack/react-query": "^5.51.0",
    "@warimaru/domain": "workspace:*",
    "next": "^15.5.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint-config-next": "^15.3.0",
    "jsdom": "^24.1.0",
    "stylelint": "^17.14.1",
    "stylelint-declaration-strict-value": "^1.11.1",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  }
}
