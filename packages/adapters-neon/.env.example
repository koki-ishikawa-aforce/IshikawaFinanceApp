# 統合テスト / drizzle-kit migrate 用の接続文字列
# ローカル: docker compose up -d db 後に以下をそのまま使用
# 実 Neon: Free Tier の接続情報をローカルでのみ設定（CI には持ち込まない）
# 注意: 統合テストは全テーブルを TRUNCATE するため、DB 名が warimaru_test 以外の
# 接続は拒否される（意図的に解除する場合のみ ALLOW_DB_RESET=1）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/warimaru_test
