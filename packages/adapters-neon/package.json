{
  "name": "@warimaru/adapters-neon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src tests scripts --ext .ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:dev": "tsx scripts/seed.ts --with-dev-fixtures"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@warimaru/domain": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "ulid": "^3.0.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^3.2.6",
    "dotenv": "^16.4.0",
    "tsx": "^4.16.0",
    "drizzle-kit": "^0.31.10",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  }
}
