        <mxCell id="rel_master_to_classify" value="Customer-Supplier&lt;br&gt;&lt;font style='font-size:9px;'&gt;削除時リマップ要請&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#1b6ca8;fontColor=#1b6ca8;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ctx_master" target="ctx_auto_classify"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2160" y="820"/><mxPoint x="1600" y="820"/></Array></mxGeometry></mxCell>

        <!-- マスタ管理 → 経費精算: Customer-Supplier（経費種別・月次上限を供給） -->
        <mxCell id="rel_master_to_expense" value="Customer-Supplier&lt;br&gt;&lt;font style='font-size:9px;'&gt;経費種別・月次上限供給&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#1b6ca8;fontColor=#1b6ca8;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ctx_master" target="ctx_expense"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2160" y="1200"/><mxPoint x="1960" y="1200"/></Array></mxGeometry></mxCell>

        <!-- マスタ管理 → 家計分析: Customer-Supplier（カテゴリ削除時に取引移動先反映） -->
        <mxCell id="rel_master_to_analysis" value="Customer-Supplier&lt;br&gt;&lt;font style='font-size:9px;'&gt;カテゴリ削除→取引移動反映&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#1b6ca8;fontColor=#1b6ca8;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ctx_master" target="ctx_household_analysis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2160" y="1050"/><mxPoint x="1960" y="1050"/></Array></mxGeometry></mxCell>

        <!-- ===== 通知配信 ↔ 家計分析 ===== -->
        <!-- 家計分析 → 通知配信: Open Host Service（CSV確定昇格時にレポートサマリ配信依頼） -->
        <mxCell id="rel_analysis_to_notif" value="Open Host Service&lt;br&gt;&lt;font style='font-size:9px;'&gt;レポートサマリ配信依頼&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#7f8c8d;fontColor=#7f8c8d;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ctx_household_analysis" target="ctx_notification"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===== 外部システムとの ACL 関係 ===== -->

        <!-- Gmail → 取引取込: ACL -->
        <mxCell id="rel_gmail_to_import" value="ACL&lt;br&gt;&lt;font style='font-size:9px;'&gt;OAuthトークン管理&lt;br&gt;+メッセージ取得&lt;br&gt;+重複除外&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;endFill=1;startArrow=none;strokeColor=#f39c12;fontColor=#a04000;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="ext_gmail" target="ctx_import"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- SMBC → 取引取込: ACL -->
