        <!-- LINE Login → オンボーディング・認証: ACL -->
        <mxCell id="rel_linelogin_to_onboarding" value="ACL&lt;br&gt;&lt;font style='font-size:9px;'&gt;LIFF 初期化&lt;br&gt;+LINE userID→内部ID変換&lt;br&gt;+許可リスト照合&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;endFill=1;startArrow=none;strokeColor=#f39c12;fontColor=#a04000;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="ext_line_login" target="ctx_onboarding"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="395"/><mxPoint x="1500" y="695"/></Array></mxGeometry></mxCell>

        <!-- 通知配信 → LINE Messaging API: Conformist -->
        <mxCell id="rel_notif_to_linemsg" value="Conformist&lt;br&gt;&lt;font style='font-size:9px;'&gt;Flex Message 仕様に従う&lt;br&gt;Channel Access Token 管理&lt;br&gt;push API 呼び出し&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#f39c12;fontColor=#a04000;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="ctx_notification" target="ext_line_msg"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 残高・資産推移管理 ← 別銀行貯蓄口座: ACL（手入力）-->
